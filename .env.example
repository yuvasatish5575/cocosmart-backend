# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string. Checkout runs inside a multi-document transaction,
# which MongoDB only supports on a replica set.
#
# For local dev (no Atlas account, no dashboard visits, never auto-pauses):
# run `npm run db:local` in a separate terminal first, then use the URL it
# prints (matches the default below).
DATABASE_URL="mongodb://127.0.0.1:27117/cocosmart?replicaSet=testset"
#
# For MongoDB Atlas instead (a free cluster is already a replica set, so it
# works with no extra setup, but the free tier auto-pauses after inactivity —
# get yours from https://cloud.mongodb.com -> Database -> Connect -> Drivers):
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cocosmart?retryWrites=true&w=majority"

# Signing secrets for JWTs — generate real random values for any non-local environment,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
FRONTEND_URL="http://localhost:5173"

# Seed script credentials — change before seeding anything but a local dev database.
SEED_ADMIN_EMAIL="admin@cocosmart.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Resend API key for sending password-reset and email-verification codes
# (https://resend.com/api-keys). Leave unset for local dev: emails fall back
# to an auto-created Ethereal test inbox, with a preview link printed to the
# server console.
# RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="CocoSmart <onboarding@resend.dev>"
