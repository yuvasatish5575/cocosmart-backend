# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# For the built-in local Postgres (no Docker/WSL required): run `npm run db:local`
# in a separate terminal first, then use the URL it prints (matches the default below).
# For Docker Compose: postgresql://cocosmart:cocosmart@localhost:5432/cocosmart
DATABASE_URL="postgresql://cocosmart:cocosmart@127.0.0.1:5433/cocosmart"

# Signing secrets for JWTs — generate real random values for any non-local environment,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
FRONTEND_URL="http://localhost:5173"

# Seed script credentials — change before seeding anything but a local dev database.
SEED_ADMIN_EMAIL="admin@cocosmart.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Resend API key for sending password-reset emails (https://resend.com/api-keys).
# Leave unset for local dev: emails fall back to an auto-created Ethereal test
# inbox, with a preview link printed to the server console.
# RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="CocoSmart <onboarding@resend.dev>"
